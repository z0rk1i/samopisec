{:deps true
 :builds {:app
          {:target :react-native
           :init-fn app.core/init
           :output-dir "app"
           :compiler-options {:source-map-path "app/"
                              :source-map-include-sources-content true
                              :warnings-as-errors true}
           :devtools {:preloads [uix.preload preload]
                      :build-notify preload/build-notify}}
          :test
          {:target :node-test
           :output-to "target/test/test.js"
           :output-dir "target/test/out"
           :ns-regexp "-test$"}}}