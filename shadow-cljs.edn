{:deps true
 :builds {:app
          {:target :react-native
           :init-fn app.core/init
           :output-dir "app"
           :compiler-options {:source-map-path "app/"
                              :source-map-include-sources-content true
                              :warnings-as-errors true}
           :devtools {:preloads [uix.preload preload]
                      :build-notify preload/build-notify}}
          :test
          {:target :node-test
           :output-to "target/test/test.js"
           :output-dir "target/test/out"
           :ns-regexp "-test$"}}
          :panel-repro
          {:target :node-script
           :main panel-repro/run
           :output-to "/tmp/panel_repro.js"
           :output-dir "/tmp/panel_repro_out"
           :compiler-options {:warnings-as-errors false}}
          :series-repro
          {:target :node-script
           :main series-repro/run
           :output-to "/tmp/series_repro.js"
           :output-dir "/tmp/series_repro_out"
           :compiler-options {:warnings-as-errors false}}}}
