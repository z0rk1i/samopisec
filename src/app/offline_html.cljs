(ns app.offline-html)

(def html "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Samopisec Grafana (offline)</title>\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;background:#0b0c0e;color:#d8dee9;font-family:-apple-system,BlinkMacSystemFont,Inter,Roboto,sans-serif}\n  header{padding:12px 16px;background:#111217;border-bottom:1px solid #2a2a2e;display:flex;align-items:center;gap:12px}\n  header h1{margin:0;font-size:16px;font-weight:600;color:#fff}\n  header span{font-size:12px;color:#9ba0b0}\n  .grid{padding:12px;display:grid;gap:12px;grid-template-columns:1fr}\n  @media(min-width:700px){.grid{grid-template-columns:1fr 1fr}}\n  .panel{background:#1f1f23;border:1px solid #2a2a2e;border-radius:6px;padding:12px}\n  .panel h2{margin:0 0 8px 0;font-size:13px;font-weight:600;color:#c2c8d6;letter-spacing:.02em;text-transform:uppercase}\n  canvas{width:100%;height:180px;display:block}\n  table{width:100%;border-collapse:collapse;font-size:12px}\n  th,td{padding:6px 8px;border-bottom:1px solid #2a2a2e;text-align:left}\n  th{color:#8a90a3;font-weight:600}\n  .empty{padding:24px;text-align:center;color:#8a90a3;font-size:13px}\n  .pill{padding:2px 8px;border-radius:10px;background:#2a2a2e;color:#d8dee9;font-size:11px}\n  .legend{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:6px}\n  .legend-item{display:flex;align-items:center;gap:6px;font-size:11px;color:#c2c8d6}\n  .legend-dot{width:10px;height:10px;border-radius:5px}\n  .panel h2 .unit{text-transform:none;font-weight:400;color:#8a90a3;font-size:11px;letter-spacing:0}\n</style>\n</head>\n<body>\n<header>\n  <h1>Samopisec</h1>\n  <span id=\"subtitle\">offline • Grafana style • по кнопкам</span>\n  <span style=\"flex:1\"></span>\n  <span class=\"pill\" id=\"total\">—</span>\n</header>\n<div class=\"grid\">\n  <div class=\"panel\" id=\"p-cumulative\"><h2>Cumulative (per button)</h2><div id=\"legend-cumulative\" class=\"legend\"></div><canvas id=\"c-cumulative\" width=\"600\" height=\"220\"></canvas><div id=\"e-cumulative\" class=\"empty\" style=\"display:none\">нет данных</div></div>\n  <div class=\"panel\" id=\"p-p1\"><h2>Производная 1 <span class=\"unit\">нажатий/час</span></h2><div id=\"legend-p1\" class=\"legend\"></div><canvas id=\"c-p1\" width=\"600\" height=\"220\"></canvas><div id=\"e-p1\" class=\"empty\" style=\"display:none\">нет данных</div></div>\n  <div class=\"panel\" id=\"p-p2\"><h2>Производная 2 <span class=\"unit\">Δ нажатий/час²</span></h2><div id=\"legend-p2\" class=\"legend\"></div><canvas id=\"c-p2\" width=\"600\" height=\"220\"></canvas><div id=\"e-p2\" class=\"empty\" style=\"display:none\">нет данных</div></div>\n  <div class=\"panel\" id=\"p-totals\"><h2>Totals per button</h2><canvas id=\"c-totals\" width=\"600\" height=\"220\"></canvas><div id=\"e-totals\" class=\"empty\" style=\"display:none\">нет данных</div></div>\n  <div class=\"panel\" id=\"p-hour\"><h2>Per-hour heatmap (0–23)</h2><canvas id=\"c-hour\" width=\"600\" height=\"220\"></canvas><div id=\"e-hour\" class=\"empty\" style=\"display:none\">нет данных</div></div>\n  <div class=\"panel\" id=\"p-raw\"><h2>Raw CSV</h2><div style=\"max-height:220px;overflow:auto\"><table id=\"t-raw\"><thead><tr><th>id</th><th>button_id</th><th>ts</th><th>time</th></tr></thead><tbody></tbody></table></div><div id=\"e-raw\" class=\"empty\" style=\"display:none\">нет данных</div></div>\n</div>\n<script>\nfunction parseCSV(text){\n  if(!text) return [];\n  const lines=text.split(/\\r?\\n/).filter(l=>l.trim()!==\"\");\n  if(!lines.length) return [];\n  const header=lines[0].trim();\n  const hasHeader=header===\"id,button_id,ts\";\n  const data=hasHeader?lines.slice(1):lines;\n  const out=[];\n  for(const l of data){\n    const p=l.split(\",\");\n    if(p.length!==3) continue;\n    const id=p[0], button_id=p[1], ts=parseInt(p[2],10);\n    if(!id||!button_id||isNaN(ts)||ts<=0) continue;\n    out.push({id,button_id,ts});\n  }\n  return out;\n}\nfunction fmtTime(ts){\n  try{return new Date(ts).toLocaleString()}catch(e){return String(ts)}\n}\n// --- производные (порт app.math: bins -> rate -> MA(5) -> вторая разность) ---\nconst HOUR=3600000;\nfunction autoBinSizeMs(rangeMs){\n  const DAY=24*HOUR;\n  if(rangeMs<3*DAY) return HOUR;\n  if(rangeMs<14*DAY) return 6*HOUR;\n  return DAY;\n}\nfunction buildBins(startMs,endMs,bin){\n  // число бинов округляется ВВЕРХ: хвостовой частичный бин сохраняется\n  const n=Math.max(1,Math.floor((endMs-startMs+bin-1)/bin));\n  const out=[];\n  for(let i=0;i<n;i++) out.push({start:startMs+i*bin,end:startMs+(i+1)*bin});\n  return out;\n}\nfunction tapRate(sortedTs,bins){\n  const out=[]; let i=0;\n  for(const b of bins){\n    let c=0;\n    while(i<sortedTs.length&&sortedTs[i]<b.end){c++;i++;}\n    out.push({t:b.start,count:c,rate:c*HOUR/(b.end-b.start)});\n  }\n  return out;\n}\nfunction movingAverage(xs,w){\n  const n=xs.length; if(!n) return [];\n  w=Math.max(1,Math.min(w,n)); const half=Math.floor(w/2);\n  const cs=[0]; for(let i=0;i<n;i++) cs.push(cs[i]+xs[i]);\n  const out=[];\n  for(let i=0;i<n;i++){\n    const lo=Math.max(0,i-half),hi=Math.min(n,i+half+1);\n    out.push((cs[hi]-cs[lo])/(hi-lo));\n  }\n  return out;\n}\nfunction secondDerivative(rates,dtHours){\n  const n=rates.length; dtHours=Math.max(1e-9,dtHours);\n  const out=new Array(n);\n  for(let i=0;i<n;i++){\n    if(n===1) out[i]=0;\n    else if(i===0) out[i]=(rates[1]-rates[0])/dtHours;\n    else if(i===n-1) out[i]=(rates[i]-rates[i-1])/dtHours;\n    else out[i]=(rates[i+1]-rates[i-1])/(2*dtHours);\n  }\n  return out;\n}\nfunction fmtNum(v){\n  const a=Math.abs(v);\n  if(a>=100) return String(Math.round(v));\n  if(a>=10) return v.toFixed(1);\n  return v.toFixed(2);\n}\nfunction derivativeSeries(dps,buttons,kind,t0,t1,bin,dtHours){\n  const bins=buildBins(t0,t1,bin);\n  return buttons.map(b=>{\n    const ts=dps.filter(d=>d.button_id===b.id).map(d=>d.ts).sort((x,y)=>x-y);\n    if(!ts.length) return null;\n    const rates=tapRate(ts,bins);\n    const vals=kind===1 ? rates.map(r=>r.rate)\n      : secondDerivative(movingAverage(rates.map(r=>r.rate),5),dtHours);\n    return {color:b.color||\"#6da5ff\",pts:rates.map((r,i)=>({t:r.t,v:vals[i]}))};\n  }).filter(Boolean);\n}\nfunction drawDerivative(canvas,dps,buttons,kind){\n  const ctx=canvas.getContext(\"2d\");\n  const W=canvas.width,H=canvas.height,pad=32;\n  ctx.clearRect(0,0,W,H);\n  if(!dps.length||!buttons.length) return;\n  const sortedAll=dps.slice().sort((a,b)=>a.ts-b.ts);\n  const t0=sortedAll[0].ts;\n  const t1=Math.max(sortedAll[sortedAll.length-1].ts,t0+HOUR);\n  const span=t1-t0;\n  const bin=autoBinSizeMs(span);\n  const series=derivativeSeries(dps,buttons,kind,t0,t1,bin,bin/HOUR);\n  if(!series.length) return;\n  let min=0,max=0;\n  series.forEach(s=>s.pts.forEach(p=>{\n    if(p.v<min)min=p.v; if(p.v>max)max=p.v;\n  }));\n  if(max===min) max=min+1;\n  const X=t=>pad+((t-t0)/span)*(W-pad*2);\n  const Y=v=>H-pad-((v-min)/(max-min))*(H-pad*2);\n  ctx.strokeStyle=\"#2a2a2e\"; ctx.lineWidth=1;\n  for(let i=0;i<=4;i++){const y=pad+i*(H-pad*2)/4;ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(W-pad,y);ctx.stroke();}\n  if(min<0&&max>0){\n    ctx.strokeStyle=\"#55555c\"; ctx.setLineDash([4,4]);\n    ctx.beginPath(); ctx.moveTo(pad,Y(0)); ctx.lineTo(W-pad,Y(0)); ctx.stroke();\n    ctx.setLineDash([]);\n  }\n  series.forEach(s=>{\n    ctx.strokeStyle=s.color; ctx.lineWidth=2.2; ctx.lineJoin=\"round\"; ctx.lineCap=\"round\";\n    ctx.beginPath();\n    s.pts.forEach((p,i)=>{\n      const x=X(p.t),y=Y(p.v);\n      if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);\n    });\n    ctx.stroke();\n  });\n  ctx.fillStyle=\"#8a90a3\"; ctx.font=\"10px sans-serif\"; ctx.textAlign=\"left\";\n  ctx.fillText(fmtNum(max),6,12);\n  ctx.fillText(fmtNum(min),6,H-4);\n  ctx.fillText(new Date(t0).toLocaleDateString(),pad,H-6);\n  const eLabel=new Date(t1).toLocaleDateString();\n  ctx.fillText(eLabel,W-pad-ctx.measureText(eLabel).width,H-6);\n}\nfunction drawCumulativePerButton(canvas, dps, buttons){\n  const ctx=canvas.getContext(\"2d\");\n  const W=canvas.width, H=canvas.height, pad=32;\n  ctx.clearRect(0,0,W,H);\n  if(!dps.length || !buttons.length) return;\n  // global time span\n  const sortedAll=dps.slice().sort((a,b)=>a.ts-b.ts);\n  const t0=sortedAll[0].ts, t1=sortedAll[sortedAll.length-1].ts;\n  const span=Math.max(1,t1-t0);\n  // global max cumulative for Y\n  const perButtonCounts={};\n  buttons.forEach(b=>perButtonCounts[b.id]=0);\n  dps.forEach(d=>{ if(perButtonCounts.hasOwnProperty(d.button_id)) perButtonCounts[d.button_id]++; });\n  const maxCum=Math.max(1,...Object.values(perButtonCounts));\n  // grid\n  ctx.strokeStyle=\"#2a2a2e\"; ctx.lineWidth=1;\n  for(let i=0;i<=4;i++){ const y=pad+i*(H-pad*2)/4; ctx.beginPath(); ctx.moveTo(pad,y); ctx.lineTo(W-pad,y); ctx.stroke(); }\n  // per-button lines\n  buttons.forEach(b=>{\n    const bDps=dps.filter(d=>d.button_id===b.id).sort((a,b)=>a.ts-b.ts);\n    if(!bDps.length) return;\n    ctx.strokeStyle=b.color||\"#6da5ff\"; ctx.lineWidth=2.2; ctx.lineJoin=\"round\"; ctx.lineCap=\"round\"; ctx.beginPath();\n    bDps.forEach((d,i)=>{\n      const x=pad + ((d.ts - t0)/span)*(W-pad*2);\n      const y=H-pad - ((i+1)/maxCum)*(H-pad*2);\n      if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);\n    });\n    ctx.stroke();\n  });\n  // labels\n  ctx.fillStyle=\"#8a90a3\"; ctx.font=\"10px sans-serif\";\n  ctx.fillText(String(maxCum), 6, 12);\n  ctx.fillText(\"0\", 6, H-4);\n  ctx.fillText(new Date(t0).toLocaleDateString(), pad, H-6);\n  const eLabel=new Date(t1).toLocaleDateString();\n  const tw=ctx.measureText(eLabel).width;\n  ctx.fillText(eLabel, W-pad-tw, H-6);\n}\nfunction drawBar(canvas, labels, values, colors){\n  const ctx=canvas.getContext(\"2d\");\n  const W=canvas.width, H=canvas.height, pad=32;\n  ctx.clearRect(0,0,W,H);\n  if(!labels.length) return;\n  const max=Math.max(1,...values);\n  const n=labels.length;\n  const gap=8;\n  const barW=(W-pad*2 - gap*(n-1))/n;\n  ctx.strokeStyle=\"#2a2a2e\"; ctx.lineWidth=1;\n  for(let i=0;i<=4;i++){ const y=pad+i*(H-pad*2)/4; ctx.beginPath(); ctx.moveTo(pad,y); ctx.lineTo(W-pad,y); ctx.stroke(); }\n  labels.forEach((lab,i)=>{\n    const v=values[i];\n    const h=(v/max)*(H-pad*2);\n    const x=pad + i*(barW+gap);\n    const y=H-pad - h;\n    ctx.fillStyle=colors[i]||\"#6da5ff\";\n    ctx.fillRect(x,y,barW,h);\n    ctx.fillStyle=\"#c2c8d6\"; ctx.font=\"10px sans-serif\"; ctx.textAlign=\"center\";\n    const tx=x+barW/2;\n    let txt=lab.length>8?lab.slice(0,8)+\"…\":lab;\n    ctx.fillText(txt, tx, H-pad+12);\n    ctx.fillStyle=\"#8a90a3\";\n    ctx.fillText(String(v), tx, y-4);\n  });\n  ctx.textAlign=\"left\";\n}\nfunction render(csvText, buttons){\n  const dps=parseCSV(csvText);\n  const btns=buttons && buttons.length ? buttons : [];\n  // header buttons map\n  const btnMap={};\n  btns.forEach(b=>btnMap[b.id]=b);\n  // fallback colors if no buttons\n  const fallbackColors=[\"#e53935\",\"#1e88e5\",\"#43a047\",\"#fb8c00\",\"#8e24aa\",\"#fdd835\"];\n  const effectiveButtons=btns.length ? btns : Object.keys(dps.reduce((a,d)=>{a[d.button_id]=1;return a},{})).map((id,i)=>({id,label:id,color:fallbackColors[i%fallbackColors.length]}));\n  document.getElementById(\"total\").textContent=dps.length+\" points • \"+effectiveButtons.length+\" кнопок\";\n  // легенды\n  const fillLegend=(id,btns)=>{\n    const legend=document.getElementById(id);\n    legend.innerHTML=\"\";\n    btns.forEach(b=>{\n      const el=document.createElement(\"div\");\n      el.className=\"legend-item\";\n      el.innerHTML='<span class=\"legend-dot\" style=\"background:'+b.color+'\"></span>'+b.label;\n      legend.appendChild(el);\n    });\n  };\n  fillLegend(\"legend-cumulative\",effectiveButtons);\n  fillLegend(\"legend-p1\",effectiveButtons);\n  fillLegend(\"legend-p2\",effectiveButtons);\n  // raw\n  const tbody=document.querySelector(\"#t-raw tbody\");\n  tbody.innerHTML=\"\";\n  if(!dps.length){\n    document.getElementById(\"e-raw\").style.display=\"block\";\n  } else {\n    document.getElementById(\"e-raw\").style.display=\"none\";\n    dps.slice().sort((a,b)=>b.ts-a.ts).slice(0,100).forEach(d=>{\n      const tr=document.createElement(\"tr\");\n      tr.innerHTML=\"<td>\"+d.id.slice(0,8)+\"</td><td>\"+d.button_id+\"</td><td>\"+d.ts+\"</td><td>\"+fmtTime(d.ts)+\"</td>\";\n      tbody.appendChild(tr);\n    });\n  }\n  // cumulative per button\n  if(!dps.length || !effectiveButtons.length){ document.getElementById(\"e-cumulative\").style.display=\"block\"; document.getElementById(\"c-cumulative\").style.display=\"none\"; }\n  else { document.getElementById(\"e-cumulative\").style.display=\"none\"; document.getElementById(\"c-cumulative\").style.display=\"block\"; drawCumulativePerButton(document.getElementById(\"c-cumulative\"), dps, effectiveButtons); }\n  // производная 1 (rate) и производная 2 (accel), по кнопкам\n  if(!dps.length || !effectiveButtons.length){ document.getElementById(\"e-p1\").style.display=\"block\"; document.getElementById(\"c-p1\").style.display=\"none\"; }\n  else { document.getElementById(\"e-p1\").style.display=\"none\"; document.getElementById(\"c-p1\").style.display=\"block\"; drawDerivative(document.getElementById(\"c-p1\"), dps, effectiveButtons, 1); }\n  if(!dps.length || !effectiveButtons.length){ document.getElementById(\"e-p2\").style.display=\"block\"; document.getElementById(\"c-p2\").style.display=\"none\"; }\n  else { document.getElementById(\"e-p2\").style.display=\"none\"; document.getElementById(\"c-p2\").style.display=\"block\"; drawDerivative(document.getElementById(\"c-p2\"), dps, effectiveButtons, 2); }\n  // totals per button with button colors\n  if(!dps.length){ document.getElementById(\"e-totals\").style.display=\"block\"; document.getElementById(\"c-totals\").style.display=\"none\"; }\n  else {\n    document.getElementById(\"e-totals\").style.display=\"none\"; document.getElementById(\"c-totals\").style.display=\"block\";\n    const freq={}; dps.forEach(d=>freq[d.button_id]=(freq[d.button_id]||0)+1);\n    const labels=effectiveButtons.map(b=>b.label), values=effectiveButtons.map(b=>freq[b.id]||0), colors=effectiveButtons.map(b=>b.color);\n    drawBar(document.getElementById(\"c-totals\"), labels, values, colors);\n  }\n  // per-hour (still total)\n  if(!dps.length){ document.getElementById(\"e-hour\").style.display=\"block\"; document.getElementById(\"c-hour\").style.display=\"none\"; }\n  else {\n    document.getElementById(\"e-hour\").style.display=\"none\"; document.getElementById(\"c-hour\").style.display=\"block\";\n    const perHour=Array(24).fill(0);\n    dps.forEach(d=>{ const h=new Date(d.ts).getHours(); perHour[h]++; });\n    const labels=perHour.map((_,i)=>String(i)), values=perHour;\n    drawBar(document.getElementById(\"c-hour\"), labels, values, perHour.map(_=>\"#ff9830\"));\n  }\n}\nfunction init(){\n  let csv=window.SAMOPISEC_CSV || \"\";\n  let buttons=window.SAMOPISEC_BUTTONS || [];\n  if(!csv && window.__SAMOPISEC_CSV) csv=window.__SAMOPISEC_CSV;\n  if(!buttons.length && window.__SAMOPISEC_BUTTONS) buttons=window.__SAMOPISEC_BUTTONS;\n  try{ if(typeof buttons===\"string\") buttons=JSON.parse(buttons); }catch(e){}\n  render(csv, buttons);\n  window.addEventListener(\"message\", function(e){\n    try{\n      const data=typeof e.data===\"string\"?e.data: JSON.stringify(e.data);\n      if(data && data.indexOf(\"id,button_id,ts\")!==-1) render(data, buttons);\n    }catch(err){}\n  });\n  document.addEventListener(\"message\", function(e){\n    try{\n      const d=e.data;\n      if(d && typeof d===\"string\" && d.indexOf(\"id,button_id,ts\")!==-1) render(d, buttons);\n    }catch(err){}\n  });\n}\nif(document.readyState===\"loading\") document.addEventListener(\"DOMContentLoaded\", init); else init();\n</script>\n</body>\n</html>\n")
