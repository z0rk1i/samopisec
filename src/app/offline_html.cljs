(ns app.offline-html)

(def html "<!DOCTYPE html>\n<html>\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>Samopisec Grafana (offline)</title>\n<style>\n  *{box-sizing:border-box}\n  body{margin:0;background:#0b0c0e;color:#d8dee9;font-family:-apple-system,BlinkMacSystemFont,Inter,Roboto,sans-serif}\n  header{padding:12px 16px;background:#111217;border-bottom:1px solid #2a2a2e;display:flex;align-items:center;gap:12px}\n  header h1{margin:0;font-size:16px;font-weight:600;color:#fff}\n  header span{font-size:12px;color:#9ba0b0}\n  .grid{padding:12px;display:grid;gap:12px;grid-template-columns:1fr}\n  @media(min-width:700px){.grid{grid-template-columns:1fr 1fr}}\n  .panel{background:#1f1f23;border:1px solid #2a2a2e;border-radius:6px;padding:12px}\n  .panel h2{margin:0 0 8px 0;font-size:13px;font-weight:600;color:#c2c8d6;letter-spacing:.02em;text-transform:uppercase}\n  canvas{width:100%;height:180px;display:block}\n  table{width:100%;border-collapse:collapse;font-size:12px}\n  th,td{padding:6px 8px;border-bottom:1px solid #2a2a2e;text-align:left}\n  th{color:#8a90a3;font-weight:600}\n  .empty{padding:24px;text-align:center;color:#8a90a3;font-size:13px}\n  .pill{padding:2px 8px;border-radius:10px;background:#2a2a2e;color:#d8dee9;font-size:11px}\n  .legend{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:6px}\n  .legend-item{display:flex;align-items:center;gap:6px;font-size:11px;color:#c2c8d6}\n  .legend-dot{width:10px;height:10px;border-radius:5px}\n  .panel h2 .unit{text-transform:none;font-weight:400;color:#8a90a3;font-size:11px;letter-spacing:0}\n</style>\n</head>\n<body>\n<header>\n  <h1>Samopisec</h1>\n  <span id=\"subtitle\">offline \u2022 Grafana style \u2022 \u043f\u043e \u043a\u043d\u043e\u043f\u043a\u0430\u043c</span>\n  <span style=\"flex:1\"></span>\n  <span class=\"pill\" id=\"total\">\u2014</span>\n</header>\n<div class=\"grid\">\n  <div class=\"panel\" id=\"p-cumulative\"><h2>Cumulative (per button)</h2><div id=\"legend-cumulative\" class=\"legend\"></div><canvas id=\"c-cumulative\" width=\"600\" height=\"220\"></canvas><div id=\"e-cumulative\" class=\"empty\" style=\"display:none\">\u043d\u0435\u0442 \u0434\u0430\u043d\u043d\u044b\u0445</div></div>\n  <div class=\"panel\" id=\"p-p1\"><h2>\u041f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u0430\u044f 1 <span class=\"unit\">\u043d\u0430\u0436\u0430\u0442\u0438\u0439/\u0447\u0430\u0441</span></h2><div id=\"legend-p1\" class=\"legend\"></div><canvas id=\"c-p1\" width=\"600\" height=\"220\"></canvas><div id=\"e-p1\" class=\"empty\" style=\"display:none\">\u043d\u0435\u0442 \u0434\u0430\u043d\u043d\u044b\u0445</div></div>\n  <div class=\"panel\" id=\"p-p2\"><h2>\u041f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u0430\u044f 2 <span class=\"unit\">\u0394 \u043d\u0430\u0436\u0430\u0442\u0438\u0439/\u0447\u0430\u0441\u00b2</span></h2><div id=\"legend-p2\" class=\"legend\"></div><canvas id=\"c-p2\" width=\"600\" height=\"220\"></canvas><div id=\"e-p2\" class=\"empty\" style=\"display:none\">\u043d\u0435\u0442 \u0434\u0430\u043d\u043d\u044b\u0445</div></div>\n  <div class=\"panel\" id=\"p-totals\"><h2>Totals per button</h2><canvas id=\"c-totals\" width=\"600\" height=\"220\"></canvas><div id=\"e-totals\" class=\"empty\" style=\"display:none\">\u043d\u0435\u0442 \u0434\u0430\u043d\u043d\u044b\u0445</div></div>\n  <div class=\"panel\" id=\"p-raw\"><h2>Raw CSV</h2><div style=\"max-height:220px;overflow:auto\"><table id=\"t-raw\"><thead><tr><th>id</th><th>button_id</th><th>ts</th><th>time</th></tr></thead><tbody></tbody></table></div><div id=\"e-raw\" class=\"empty\" style=\"display:none\">\u043d\u0435\u0442 \u0434\u0430\u043d\u043d\u044b\u0445</div></div>\n</div>\n<script>\n// \u0412\u0441\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u043f\u0440\u0438\u0445\u043e\u0434\u044f\u0442 \u0413\u041e\u0422\u041e\u0412\u042b\u041c\u0418 \u0438\u0437 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f (app.grafana-series, CLJS:\n// app.math + decimation) \u0447\u0435\u0440\u0435\u0437 window.SAMOPISEC_SERIES. \u0417\u0434\u0435\u0441\u044c \u0442\u043e\u043b\u044c\u043a\u043e \u043e\u0442\u0440\u0438\u0441\u043e\u0432\u043a\u0430:\n// \u0431\u0435\u0437 \u043f\u0430\u0440\u0441\u0438\u043d\u0433\u0430 CSV \u0438 \u0431\u0435\u0437 \u0432\u0442\u043e\u0440\u043e\u0439 \u0440\u0435\u0430\u043b\u0438\u0437\u0430\u0446\u0438\u0438 \u043c\u0430\u0442\u0435\u043c\u0430\u0442\u0438\u043a\u0438 \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0445.\nfunction fmtTime(ts){\n  try{return new Date(ts).toLocaleString()}catch(e){return String(ts)}\n}\nfunction fmtNum(v){\n  const a=Math.abs(v);\n  if(a>=100) return String(Math.round(v));\n  if(a>=10) return v.toFixed(1);\n  return v.toFixed(2);\n}\nfunction show(id,on){\n  document.getElementById(id).style.display=on?\"block\":\"none\";\n}\nfunction fillLegend(id,btns){\n  const legend=document.getElementById(id);\n  legend.innerHTML=\"\";\n  btns.forEach(b=>{\n    const el=document.createElement(\"div\");\n    el.className=\"legend-item\";\n    const dot=document.createElement(\"span\");\n    dot.className=\"legend-dot\";\n    dot.style.background=b.color;\n    const tx=document.createElement(\"span\");\n    tx.textContent=b.label; // textContent: label \u0438\u0437 \u043a\u043e\u043d\u0444\u0438\u0433\u0430 \u043d\u0435 \u0438\u043d\u0442\u0435\u0440\u043f\u0440\u0435\u0442\u0438\u0440\u0443\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u0440\u0430\u0437\u043c\u0435\u0442\u043a\u0430\n    el.appendChild(dot);\n    el.appendChild(tx);\n    legend.appendChild(el);\n  });\n}\nfunction drawLines(canvas,lines,t0,t1,zeroLine){\n  const ctx=canvas.getContext(\"2d\");\n  const W=canvas.width,H=canvas.height,pad=32;\n  ctx.clearRect(0,0,W,H);\n  if(!lines.length||!(t1>t0)) return;\n  let min=0,max=0;\n  lines.forEach(l=>l.pts.forEach(p=>{\n    if(p.v<min)min=p.v; if(p.v>max)max=p.v;\n  }));\n  if(max===min) max=min+1;\n  const span=t1-t0;\n  const X=t=>pad+((t-t0)/span)*(W-pad*2);\n  const Y=v=>H-pad-((v-min)/(max-min))*(H-pad*2);\n  ctx.strokeStyle=\"#2a2a2e\"; ctx.lineWidth=1;\n  for(let i=0;i<=4;i++){const y=pad+i*(H-pad*2)/4;ctx.beginPath();ctx.moveTo(pad,y);ctx.lineTo(W-pad,y);ctx.stroke();}\n  if(zeroLine&&min<0&&max>0){\n    ctx.strokeStyle=\"#55555c\"; ctx.setLineDash([4,4]);\n    ctx.beginPath(); ctx.moveTo(pad,Y(0)); ctx.lineTo(W-pad,Y(0)); ctx.stroke();\n    ctx.setLineDash([]);\n  }\n  lines.forEach(l=>{\n    if(!l.pts.length) return;\n    ctx.strokeStyle=l.color||\"#6da5ff\"; ctx.lineWidth=2.2; ctx.lineJoin=\"round\"; ctx.lineCap=\"round\";\n    ctx.beginPath();\n    l.pts.forEach((p,i)=>{\n      const x=X(p.t),y=Y(p.v);\n      if(i===0) ctx.moveTo(x,y); else ctx.lineTo(x,y);\n    });\n    ctx.stroke();\n  });\n  ctx.fillStyle=\"#8a90a3\"; ctx.font=\"10px sans-serif\"; ctx.textAlign=\"left\";\n  ctx.fillText(fmtNum(max),6,12);\n  ctx.fillText(fmtNum(min),6,H-4);\n  ctx.fillText(new Date(t0).toLocaleDateString(),pad,H-6);\n  const eLabel=new Date(t1).toLocaleDateString();\n  ctx.fillText(eLabel,W-pad-ctx.measureText(eLabel).width,H-6);\n}\nfunction drawBar(canvas, labels, values, colors){\n  const ctx=canvas.getContext(\"2d\");\n  const W=canvas.width, H=canvas.height, pad=32;\n  ctx.clearRect(0,0,W,H);\n  if(!labels.length) return;\n  const max=Math.max(1,...values);\n  const n=labels.length;\n  const gap=8;\n  const barW=(W-pad*2 - gap*(n-1))/n;\n  ctx.strokeStyle=\"#2a2a2e\"; ctx.lineWidth=1;\n  for(let i=0;i<=4;i++){ const y=pad+i*(H-pad*2)/4; ctx.beginPath(); ctx.moveTo(pad,y); ctx.lineTo(W-pad,y); ctx.stroke(); }\n  labels.forEach((lab,i)=>{\n    const v=values[i];\n    const h=(v/max)*(H-pad*2);\n    const x=pad + i*(barW+gap);\n    const y=H-pad - h;\n    ctx.fillStyle=colors[i]||\"#6da5ff\";\n    ctx.fillRect(x,y,barW,h);\n    ctx.fillStyle=\"#c2c8d6\"; ctx.font=\"10px sans-serif\"; ctx.textAlign=\"center\";\n    const tx=x+barW/2;\n    let txt=lab.length>8?lab.slice(0,8)+\"\u2026\":lab;\n    ctx.fillText(txt, tx, H-pad+12);\n    ctx.fillStyle=\"#8a90a3\";\n    ctx.fillText(String(v), tx, y-4);\n  });\n  ctx.textAlign=\"left\";\n}\nfunction render(S){\n  S=S||{};\n  const points=S.points||0, btns=S.buttons||[], curves=S.curves||[];\n  const t0=(S.window&&S.window.t0)||0, t1=(S.window&&S.window.t1)||0;\n  document.getElementById(\"total\").textContent=points+\" points \u2022 \"+btns.length+\" \u043a\u043d\u043e\u043f\u043e\u043a\";\n  fillLegend(\"legend-cumulative\",btns);\n  fillLegend(\"legend-p1\",btns);\n  fillLegend(\"legend-p2\",btns);\n  // raw rows\n  const tbody=document.querySelector(\"#t-raw tbody\");\n  tbody.innerHTML=\"\";\n  const recent=S.recent||[];\n  if(!recent.length){ show(\"e-raw\",true); }\n  else {\n    show(\"e-raw\",false);\n    recent.forEach(r=>{\n      const tr=document.createElement(\"tr\");\n      // textContent: \u0431\u0435\u0437 \u0438\u043d\u044a\u0435\u043a\u0446\u0438\u0438 \u0440\u0430\u0437\u043c\u0435\u0442\u043a\u0438 \u0438\u0437 \u0434\u0430\u043d\u043d\u044b\u0445\n      [String(r[0]).slice(0,8), r[1], String(r[2]), fmtTime(r[2])].forEach(c=>{\n        const td=document.createElement(\"td\");\n        td.textContent=c;\n        tr.appendChild(td);\n      });\n      tbody.appendChild(tr);\n    });\n  }\n  const hasData=points>0&&btns.length>0&&(t1>t0);\n  const asLines=key=>curves.map(c=>({color:c.color,pts:c[key]||[]}));\n  const anyPts=key=>curves.some(c=>(c[key]||[]).length>0);\n  // cumulative / \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u043d\u044b\u0435 \u043f\u0430\u043d\u0435\u043b\u0438\n  [[\"cumulative\",\"c-cumulative\",\"e-cumulative\",false],\n   [\"p1\",\"c-p1\",\"e-p1\",false],\n   [\"p2\",\"c-p2\",\"e-p2\",true]].forEach(([key,cid,eid,zero])=>{\n    const on=hasData&&anyPts(key);\n    show(cid,on); show(eid,!on);\n    if(on) drawLines(document.getElementById(cid),asLines(key),t0,t1,zero);\n  });\n  // totals per button\n  if(!points){ show(\"c-totals\",false); show(\"e-totals\",true); }\n  else {\n    show(\"c-totals\",true); show(\"e-totals\",false);\n    const totals=S.totals||{};\n    drawBar(document.getElementById(\"c-totals\"),\n            btns.map(b=>b.label),\n            btns.map(b=>totals[b.id]||0),\n            btns.map(b=>b.color));\n  }\n}\nfunction init(){\n  let S=window.SAMOPISEC_SERIES;\n  if(!S&&window.__SAMOPISEC_SERIES) S=window.__SAMOPISEC_SERIES;\n  try{ if(typeof S===\"string\") S=JSON.parse(S); }catch(e){}\n  render(S);\n}\nif(document.readyState===\"loading\") document.addEventListener(\"DOMContentLoaded\", init); else init();\n// \u041e\u0431\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435 \u0436\u0438\u0432\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0438\u0437 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f (react-native-webview.postMessage):\n// \u0441\u0442\u0440\u043e\u043a\u0430-JSON \u0442\u043e\u0433\u043e \u0436\u0435 payload. \u0421\u043b\u0443\u0448\u0430\u0435\u043c \u043e\u0431\u0430 \u043a\u0430\u043d\u0430\u043b\u0430 \u2014 iOS \u0438 Android \u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u044e\u0442\n// \u0441\u043e\u0431\u044b\u0442\u0438\u044f \u043f\u043e-\u0440\u0430\u0437\u043d\u043e\u043c\u0443.\nfunction onNativeMessage(e){\n  try{\n    const d=typeof e.data===\"string\"?JSON.parse(e.data):e.data;\n    if(d&&d.points!=null) render(d);\n  }catch(err){}\n}\nwindow.addEventListener(\"message\",onNativeMessage,false);\ndocument.addEventListener(\"message\",onNativeMessage,false);\n</script>\n</body>\n</html>\n")
