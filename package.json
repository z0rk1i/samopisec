{
  "scripts": {
    "dev": "concurrently --raw -k \"npm:expo:start\" \"npm:cljs:dev\"",
    "expo:start": "expo start",
    "cljs:dev": "clojure -M -m shadow.cljs.devtools.cli watch app",
    "cljs:release": "clojure -M -m shadow.cljs.devtools.cli release app",
    "test": ". scripts/env.sh && clojure -M -m shadow.cljs.devtools.cli compile test && node target/test/test.js",
    "lint": "clj-kondo --lint src test"
  },
  "main": "app/index.js",
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "expo": "^57.0.12",
    "expo-file-system": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "^19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.15.0",
    "use-sync-external-store": "^1.6.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "react-refresh": "^0.14.0"
  }
}
